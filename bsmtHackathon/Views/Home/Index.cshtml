@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="hero-wrapper mb-5">
    <div class="container position-relative">
        <div class="row align-items-center" style="min-height: 500px;">

            <div class="col-lg-6 z-index-2">
                <span class="badge bg-light text-primary border border-primary px-3 py-2 rounded-pill mb-3 fw-bold">
                    🚀 Hackathon 2025 Özel Sürümü
                </span>
                <h1 class="display-3 fw-bold mb-4" style="line-height: 1.2;">
                    Öğrenciliğin <br />
                    <span class="gradient-text">Tadını Çıkar,</span> <br />
                    Bütçeni Dert Etme.
                </h1>
                <p class="lead text-muted mb-5">
                    Cebindeki paraya, dolabındaki malzemeye ve sınav takvimine göre sana özel
                    yapay zeka destekli beslenme asistanı.
                </p>
                <div class="d-flex gap-3">
                    <a href="/Account/Register" class="btn-hero">
                        <i class="fas fa-magic me-2"></i> Planımı Oluştur
                    </a>
                    <a href="#nasil-calisir" class="btn btn-outline-dark btn-lg rounded-pill px-4">
                        Nasıl Çalışır?
                    </a>
                </div>
            </div>

            <div class="col-lg-6 position-relative d-none d-lg-block text-center">
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(79,172,254,0.1) 0%, rgba(255,255,255,0) 70%); border-radius: 50%;"></div>

                <div class="floating-icon delay-1" style="top: 10%; right: 20%;">🍕</div>
                <div class="floating-icon delay-2" style="bottom: 20%; left: 10%;">💰</div>
                <div class="floating-icon delay-3" style="top: 40%; right: 10%;">🥗</div>
                <div class="floating-icon delay-1" style="bottom: 10%; right: 30%;">🛒</div>

                <div class="card shadow-lg border-0 p-3 mx-auto" style="width: 300px; transform: rotate(-5deg); background: white;">
                    <div class="card-body">
                        <h5 class="fw-bold">Bugünün Menüsü</h5>
                        <hr />
                        <div class="d-flex align-items-center mb-3">
                            <span class="fs-2 me-3">🍳</span>
                            <div>
                                <small class="text-muted">Kahvaltı</small>
                                <div class="fw-bold">Menemen & Çay</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <span class="fs-2 me-3">🍝</span>
                            <div>
                                <small class="text-muted">Akşam</small>
                                <div class="fw-bold">Ton Balıklı Makarna</div>
                            </div>
                        </div>
                        <div class="alert alert-success py-1 mt-3 small">
                            <i class="fas fa-check-circle me-1"></i> Bütçene Uygun!
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5" id="nasil-calisir">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-6">Neden Bizi Seçmelisin?</h2>
        <p class="text-muted">Makarna yemekten fazlasını hak ediyorsun.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-box text-center">
                <div class="feature-icon mx-auto">
                    <i class="fas fa-wallet"></i>
                </div>
                <h3>Bütçe Dostu</h3>
                <p class="text-muted">
                    Haftalık harçlığını gir, kuruşu kuruşuna sana yetecek en verimli market listesini yapay zeka çıkarsın.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-box text-center">
                <div class="feature-icon mx-auto">
                    <i class="fas fa-blender"></i>
                </div>
                <h3>Ekipman Analizi</h3>
                <p class="text-muted">
                    "Sadece kettle'ım var" diyorsan sorun yok. AI sadece senin sahip olduğun aletlerle pişecek yemek önerir.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-box text-center">
                <div class="feature-icon mx-auto">
                    <i class="fas fa-heartbeat"></i>
                </div>
                <h3>Sağlık & Denge</h3>
                <p class="text-muted">
                    Sınav haftasında enerjiye mi ihtiyacın var? Protein ve vitamin dengesi gözetilerek hazırlanan menüler.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-3">
                <div class="display-4 fw-bold">100+</div>
                <div>Öğrenci Tarifi</div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="display-4 fw-bold">%30</div>
                <div>Ortalama Tasarruf</div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="display-4 fw-bold">7/24</div>
                <div>Yapay Zeka Asistan</div>
            </div>
        </div>
    </div>
</div>